# Private key RSA KÝ RESPONSE — bắt buộc. PEM đã base64-encode (base64 -w 0 private.pem).
CSHIELD_PRIVATE_KEY=<base64 của private.pem>

# (Tùy chọn) Public key cùng cặp — client dùng để verify chữ ký response. Server KHÔNG cần.
# CSHIELD_PUBLIC_KEY=<base64 của public.pem>

# Realm của CHÍNH server này — verify access token ES256 OFFLINE qua JWKS (SDK thuần ES256, không
# fallback). Server tự pin, KHÔNG lấy từ token client. Mặc định đã trỏ app sample embedded:
#   customerCode = CMCCS, applicationId = cshield-embedded-sample, environment = DEV
# => realm cmccs:cshield-embedded-sample:dev, aud tenant:cmccs:cshield-embedded-sample:dev.
# Chỉ set 2 biến dưới nếu muốn khác mặc định (environment cố định DEV trong code):
# CSHIELD_CUSTOMER_CODE=CMCCS
# CSHIELD_APPLICATION_ID=cshield-embedded-sample

# (Gốc URL JWKS KHÔNG cấu hình được — bake trong gói SDK: pack:uat = c-shield-license.cmccs.vn,
#  pack:prod = mshield.cmc.vn. Đổi môi trường = đổi bản build, không phải env var.)

# (Tùy chọn) Ngưỡng trustLevel tối thiểu (L1|L2|L3|L4|L5, mặc định "L1").
# CSHIELD_MIN_TRUST_LEVEL=L1

PORT=8080
